<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.parsarium</groupId>
  <artifactId>java-wav-adapters</artifactId>
  <version>0.1.0</version>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <repositories>
    <repository><id>tarsos-releases</id><url>https://mvn.0110.be/releases</url></repository>
  </repositories>
  <dependencies>
    <dependency><groupId>com.github.psambit9791</groupId><artifactId>wavfile</artifactId><version>1.0.0</version></dependency>
    <dependency><groupId>net.jthink</groupId><artifactId>jaudiotagger</artifactId><version>3.0.1</version></dependency>
    <dependency><groupId>org.jcodec</groupId><artifactId>jcodec</artifactId><version>0.2.5</version></dependency>
    <dependency><groupId>net.beadsproject</groupId><artifactId>beads</artifactId><version>3.2</version>
      <exclusions>
        <exclusion><groupId>org.clojars.automata</groupId><artifactId>tritonus-aos</artifactId></exclusion>
        <exclusion><groupId>org.clojars.automata</groupId><artifactId>tritonus-share</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency><groupId>me.tamkungz.codecmedia</groupId><artifactId>codecmedia</artifactId><version>1.2.2</version></dependency>
    <dependency><groupId>com.github.psambit9791</groupId><artifactId>jdsp</artifactId><version>3.1.1</version></dependency>
    <dependency><groupId>org.apache.tika</groupId><artifactId>tika-parser-audiovideo-module</artifactId><version>4.2.0</version></dependency>
    <dependency><groupId>org.apache.tika</groupId><artifactId>tika-core</artifactId><version>4.2.0</version></dependency>
    <dependency><groupId>org.openpreservation.jhove</groupId><artifactId>jhove-modules</artifactId><version>1.20.1</version></dependency>
    <dependency><groupId>org.openpreservation.jhove</groupId><artifactId>jhove-core</artifactId><version>1.20.1</version></dependency>
    <dependency><groupId>be.tarsos.dsp</groupId><artifactId>jvm</artifactId><version>2.5</version></dependency>
    <dependency><groupId>be.tarsos.dsp</groupId><artifactId>core</artifactId><version>2.5</version></dependency>
  </dependencies>
  <build><plugins>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.14.1</version></plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-dependency-plugin</artifactId><version>3.8.1</version></plugin>
  </plugins></build>
</project>
