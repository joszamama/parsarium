{
  "name": "parsarium/php-mp3-id3v2",
  "description": "Pinned PHP MP3 and ID3v2 parser package paths",
  "type": "project",
  "require": {
    "php": "^8.3",
    "christophwurst/id3parser": "v0.1.4",
    "james-heinrich/getid3": "v1.9.28",
    "nikic/php-fuzzer": "v0.0.11",
    "owen-oj/laravel-getid3": "v2.6.0",
    "wapmorgan/mp3info": "0.1.1"
  },
  "config": {"sort-packages": true, "allow-plugins": false}
}
