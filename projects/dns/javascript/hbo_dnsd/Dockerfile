FROM --platform=linux/arm64 node@sha256:c8890e48c4572d2f912bf787272b34d122a4009911a5aafe604912194ff89c47 AS build
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /work
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund \
    && curl --fail --location --retry 3 https://registry.npmjs.org/hbo-dnsd/-/hbo-dnsd-0.9.8.tgz --output /work/source.tgz \
    && echo '81e8deb17d63c3be37eba4f64aadbeeeb11db16afb38bd1645c4ed3a8f4d6bf1  /work/source.tgz' | sha256sum --check \
    && mkdir /work/source && tar -xzf /work/source.tgz -C /work/source \
    && diff -r /work/source/package /work/node_modules/hbo-dnsd \
    && grep -q 'Apache License' /work/node_modules/hbo-dnsd/LICENSE && grep -q 'Version 2.0' /work/node_modules/hbo-dnsd/LICENSE
RUN { node --version; npm --version; npm ls hbo-dnsd optimist defaultable @jazzer.js/core --depth=1; } > /work/toolchain.txt

FROM --platform=linux/arm64 node@sha256:c8890e48c4572d2f912bf787272b34d122a4009911a5aafe604912194ff89c47
WORKDIR /work
COPY --from=build /work/node_modules /work/node_modules
COPY --from=build /work/toolchain.txt /work/toolchain.txt
COPY harness.js replay.js fuzz.js run-control.js /work/
ENTRYPOINT ["node", "/work/run-control.js"]
