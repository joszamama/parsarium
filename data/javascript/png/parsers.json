    "scope": "pixels",
    "family": "pngjs",
    "family_note": "jimp@1.6.1 depends on @jimp/js-png@1.6.1, which depends on pngjs@^7.0.0."
  },
  {
    "name": "pngjs",
    "version": "7.0.0",
    "license": "MIT",
    "input_api": "PNG.sync.read(Buffer)",
