[
  {
    "name": "sharp",
    "version": "0.35.5",
    "license": "Apache-2.0",
    "input_api": "sharp(Buffer).raw().toBuffer({resolveWithObject:true})",
    "documentation": "https://sharp.pixelplumbing.com/api-constructor/",
    "scope": "pixels",
    "family": "libvips",
    "family_note": "Native wrapper; libvips performs image loading. The PNG backend beneath libvips is not determined here."
  },
  {
    "name": "image-size",
    "version": "2.1.0",
    "license": "MIT",
    "input_api": "imageSize(Buffer)",
    "documentation": "https://www.npmjs.com/package/image-size",
    "scope": "header",
    "family": "image-size"
  },
  {
    "name": "pngjs",
    "version": "7.0.0",
    "license": "MIT",
    "input_api": "PNG.sync.read(Buffer)",
    "documentation": "https://github.com/pngjs/pngjs/blob/main/README.md",
    "scope": "pixels",
    "family": "pngjs"
  },
  {
    "name": "png-js",
    "version": "2.0.0",
    "license": "MIT (upstream LICENSE; npm metadata omits license)",
    "license_evidence": "https://github.com/foliojs/png.js/blob/master/LICENSE",
    "input_api": "new PNG(Buffer).decode(callback)",
    "documentation": "https://www.npmjs.com/package/png-js",
    "scope": "pixels",
    "family": "png.js"
  },
  {
    "name": "fast-png",
    "version": "8.0.0",
    "license": "MIT",
    "input_api": "decode(Buffer)",
    "documentation": "https://www.npmjs.com/package/fast-png",
    "scope": "pixels",
    "family": "fast-png"
  },
  {
    "name": "@pdf-lib/upng",
    "version": "1.0.1",
    "license": "MIT",
    "input_api": "UPNG.decode(ArrayBuffer); UPNG.toRGBA8(image)",
    "documentation": "https://www.npmjs.com/package/@pdf-lib/upng",
    "scope": "pixels",
    "family": "UPNG.js",
    "family_note": "Fork of the UPNG.js decoder also published as upng-js."
  },
  {
    "name": "parse-png",
    "version": "2.1.0",
    "license": "MIT",
    "input_api": "parsePng(Buffer)",
    "documentation": "https://www.npmjs.com/package/parse-png",
    "scope": "pixels",
    "family": "pngjs",
    "family_note": "The pinned release depends on pngjs@^3.3.0, a separate major version of the same family."
  },
  {
    "name": "canvas",
    "version": "3.2.3",
    "license": "MIT",
    "input_api": "loadImage(Buffer); drawImage; getImageData",
    "documentation": "https://github.com/Automattic/node-canvas#imagesrc",
    "scope": "pixels",
    "family": "Cairo/libpng",
    "family_note": "Native Canvas binding; PNG decoding is delegated to the Cairo/libpng stack."
  },
  {
    "name": "@napi-rs/canvas",
    "version": "1.1.0",
    "license": "MIT",
    "input_api": "loadImage(Buffer); drawImage; getImageData",
    "documentation": "https://github.com/Brooooooklyn/canvas/blob/main/index.d.ts",
    "scope": "pixels",
    "family": "Skia",
    "family_note": "Native Node-API binding; pinned package type declarations document Buffer input."
  },
  {
    "name": "probe-image-size",
    "version": "7.5.0",
    "license": "MIT",
    "input_api": "probe.sync(Buffer)",
    "documentation": "https://www.npmjs.com/package/probe-image-size",
    "scope": "header",
    "family": "probe-image-size"
  }
]
