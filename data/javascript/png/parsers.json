    "scope": "pixels",
    "family": "UPNG.js"
  },
  {
    "name": "@pdf-lib/upng",
    "version": "1.0.1",
    "license": "MIT",
    "input_api": "UPNG.decode(ArrayBuffer); UPNG.toRGBA8(image)",
