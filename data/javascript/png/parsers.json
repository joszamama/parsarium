    "family": "pngjs"
  },
  {
    "name": "png-js",
    "version": "2.0.0",
    "license": "MIT (upstream LICENSE; npm metadata omits license)",
    "license_evidence": "https://github.com/foliojs/png.js/blob/master/LICENSE",
    "input_api": "new PNG(Buffer).decode(callback)",
    "documentation": "https://www.npmjs.com/package/png-js",
    "scope": "pixels",
    "family": "png.js"
  },
  {
    "name": "@react-pdf/png-js",
    "version": "3.0.0",
    "license": "MIT",
    "input_api": "new PNG(Buffer).decode(callback)",
    "documentation": "https://www.npmjs.com/package/@react-pdf/png-js",
    "scope": "pixels",
    "family": "png.js",
    "family_note": "Fork of the png.js decoder also published as png-js."
  },
  {
    "name": "fast-png",
    "version": "8.0.0",
    "license": "MIT",
    "input_api": "decode(Buffer)",
