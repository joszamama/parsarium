[
  {
    "name": "sharp",
    "version": "0.35.5",
    "license": "Apache-2.0",
    "input_api": "sharp(Buffer).metadata()",
    "documentation": "https://sharp.pixelplumbing.com/api-input/",
    "scope": "dimensions",
    "family": "libvips/librsvg",
    "family_note": "Native libvips SVG input backend."
  },
  {
    "name": "image-size",
    "version": "2.1.0",
    "license": "MIT",
    "input_api": "imageSize(Buffer)",
    "documentation": "https://www.npmjs.com/package/image-size",
    "scope": "dimensions",
    "family": "image-size SVG reader"
  },
  {
    "name": "probe-image-size",
    "version": "7.5.0",
    "license": "MIT",
    "input_api": "probe.sync(Buffer)",
    "documentation": "https://www.npmjs.com/package/probe-image-size",
    "scope": "dimensions",
    "family": "probe-image-size SVG reader"
  },
  {
    "name": "@napi-rs/canvas",
    "version": "1.1.0",
    "license": "MIT",
    "input_api": "loadImage(Buffer); drawImage()",
    "documentation": "https://www.npmjs.com/package/@napi-rs/canvas",
    "scope": "pixels",
    "family": "Skia",
    "family_note": "Separate binding over Skia."
  },
  {
    "name": "canvas",
    "version": "3.2.3",
    "license": "MIT",
    "input_api": "loadImage(Buffer); drawImage()",
    "documentation": "https://github.com/Automattic/node-canvas#loadimage",
    "scope": "pixels",
    "family": "Cairo/librsvg",
    "family_note": "Node canvas binding uses the system SVG rendering stack."
  },
  {
    "name": "svg-parser",
    "version": "2.1.0",
    "license": "MIT",
    "input_api": "parse(svgString)",
    "documentation": "https://www.npmjs.com/package/svg-parser",
    "scope": "structure",
    "family": "svg-parser"
  },
  {
    "name": "canvg",
    "version": "4.0.3",
    "license": "MIT",
    "input_api": "Canvg.fromString(canvasContext,svgString,presets.node(...)).render()",
    "documentation": "https://canvg.js.org/api/classes/Canvg",
    "scope": "pixels",
    "family": "canvg",
    "family_note": "Uses a supplied DOMParser to construct SVG DOM before rendering."
  },
  {
    "name": "@resvg/resvg-js",
    "version": "2.6.2",
    "license": "MPL-2.0",
    "input_api": "new Resvg(svgString).render().pixels",
    "documentation": "https://www.npmjs.com/package/@resvg/resvg-js",
    "scope": "pixels",
    "family": "resvg",
    "family_note": "Native binding around Rust resvg."
  },
  {
    "name": "@resvg/resvg-wasm",
    "version": "2.6.2",
    "license": "MPL-2.0",
    "input_api": "initWasm(localWasmBytes); new Resvg(svgString).render().pixels",
    "documentation": "https://unpkg.com/@resvg/resvg-wasm@2.6.2/index.d.ts",
    "scope": "pixels",
    "family": "resvg",
    "family_note": "WebAssembly distribution of the same Rust resvg engine."
  },
  {
    "name": "svgo",
    "version": "4.1.0",
    "license": "MIT",
    "input_api": "optimize(svgString,{plugins:['convertShapeToPath']})",
    "documentation": "https://svgo.dev/docs/introduction/",
    "scope": "optimized_paths",
    "family": "SVGO"
  }
]
