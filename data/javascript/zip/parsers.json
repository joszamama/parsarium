[
  {
    "name": "jszip",
    "version": "3.10.2",
    "license": "MIT OR GPL-3.0-or-later",
    "input_api": "JSZip.loadAsync(Buffer); zip.file(name).async('string')",
    "documentation": "https://github.com/Stuk/jszip/blob/main/documentation/api_jszip/load_async.md",
    "scope": "entries_and_content",
    "family": "JSZip"
  },
  {
    "name": "adm-zip",
    "version": "0.6.1",
    "license": "MIT",
    "input_api": "new AdmZip(Buffer); getEntries(); readAsText(entry)",
    "documentation": "https://www.npmjs.com/package/adm-zip",
    "scope": "entries_and_content",
    "family": "ADM-ZIP"
  },
  {
    "name": "yauzl",
    "version": "3.4.0",
    "license": "MIT",
    "input_api": "fromBufferPromise(Buffer); eachEntry(); openReadStreamPromise(entry)",
    "documentation": "https://www.npmjs.com/package/yauzl",
    "scope": "entries_and_content",
    "family": "yauzl"
  },
  {
    "name": "unzipper",
    "version": "0.12.5",
    "license": "MIT",
    "input_api": "Open.buffer(Buffer); entry.buffer()",
    "documentation": "https://www.npmjs.com/package/unzipper",
    "scope": "entries_and_content",
    "family": "unzipper",
    "family_note": "Uses Node zlib for DEFLATE; archive parsing is in unzipper."
  },
  {
    "name": "fflate",
    "version": "0.8.3",
    "license": "MIT",
    "input_api": "unzipSync(Uint8Array)",
    "documentation": "https://www.npmjs.com/package/fflate",
    "scope": "entries_and_content",
    "family": "fflate"
  },
  {
    "name": "@zip.js/zip.js",
    "version": "2.24.0",
    "license": "BSD-3-Clause",
    "input_api": "new ZipReader(new Uint8ArrayReader(bytes)); getEntries(); entry.getData(new TextWriter())",
    "documentation": "https://gildas-lormeau.github.io/zip.js/api/classes/ZipReader.html",
    "scope": "entries_and_content",
    "family": "zip.js"
  },
  {
    "name": "node-stream-zip",
    "version": "1.16.0",
    "license": "MIT",
    "input_api": "new StreamZip.async({file:path}); entries(); entryData(name)",
    "documentation": "https://www.npmjs.com/package/node-stream-zip",
    "scope": "entries_and_content",
    "family": "node-stream-zip"
  },
  {
    "name": "extract-zip",
    "version": "2.0.1",
    "license": "BSD-2-Clause",
    "input_api": "extract(localZipPath, {dir, onEntry})",
    "documentation": "https://www.npmjs.com/package/extract-zip",
    "scope": "entries_and_content",
    "family": "yauzl",
    "family_note": "This release depends on yauzl@^2.10.0."
  }
]
