    "scope": "tags",
    "family": "MediaInfoLib WASM"
  },
  {
    "name": "jsmediatags",
    "version": "3.9.7",
    "license": "BSD-3-Clause",
    "input_api": "read(Buffer,{onSuccess,onError})",
    "documentation": "https://www.npmjs.com/package/jsmediatags",
    "scope": "tags+version",
    "family": "jsmediatags"
  },
  {
    "name": "@audio/decode",
    "version": "4.3.0",
    "license": "MIT",
    "input_api": "decode(Buffer)",
    "documentation": "https://www.npmjs.com/package/@audio/decode",
    "scope": "decoded_audio",
    "family": "mpg123 WASM",
    "family_note": "Facade delegates MP3 decoding to @audio/decode-mp3 and mpg123-decoder WASM."
  },
  {
    "name": "@audio/decode-mp3",
    "version": "1.3.1",
    "license": "MIT",
    "input_api": "decode(Buffer)",
    "documentation": "https://www.npmjs.com/package/@audio/decode-mp3",
    "scope": "decoded_audio",
    "family": "mpg123 WASM",
    "family_note": "Uses mpg123-decoder WASM. On this mono control the codec API yielded two PCM channels; only sample rate and sample count establish acceptance of the tagged MP3."
  },
  {
    "name": "get-audio-duration",
    "version": "4.0.1",
    "license": "MIT",
    "input_api": "getAudioDurationInSeconds(path)",
    "documentation": "https://www.npmjs.com/package/get-audio-duration",
    "scope": "duration",
    "family": "FFprobe wrapper",
    "family_note": "Invokes pinned @ffprobe-installer/ffprobe; duration includes encoder padding."
  },
  {
    "name": "node-id3",
    "version": "0.2.9",
    "license": "MIT",
    "input_api": "read(Buffer)",
    "documentation": "https://www.npmjs.com/package/node-id3",
    "scope": "tags",
    "family": "node-id3"
  },
  {
    "name": "id3js",
    "version": "2.1.1",
    "license": "MIT",
    "input_api": "fromPath(path)",
    "documentation": "https://www.npmjs.com/package/id3js",
    "scope": "tags+version",
    "family": "id3js"
  },
  {
    "name": "mp3-duration",
    "version": "1.1.0",
    "license": "MIT",
    "input_api": "mp3Duration(Buffer,callback)",
    "documentation": "https://www.npmjs.com/package/mp3-duration",
    "scope": "duration",
    "family": "mp3-duration",
    "family_note": "Frame duration includes MP3 padding and differs from nominal one-second source duration."
  },
  {
    "name": "get-mp3-duration",
    "version": "1.0.0",
    "license": "MIT",
    "input_api": "getMP3Duration(Buffer)",
    "documentation": "https://www.npmjs.com/package/get-mp3-duration",
    "scope": "duration",
    "family": "get-mp3-duration",
    "family_note": "Frame duration includes MP3 padding and differs from nominal one-second source duration."
  }
]
