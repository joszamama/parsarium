[
  {
    "name": "music-metadata",
    "version": "12.4.0",
    "license": "MIT",
    "input_api": "parseFile(path)",
    "documentation": "https://www.npmjs.com/package/music-metadata",
    "scope": "tracks+title",
    "family": "music-metadata/ISO BMFF reader"
  },
  {
    "name": "mediainfo.js",
    "version": "0.3.8",
    "license": "BSD-2-Clause",
    "input_api": "MediaInfo().analyzeData(size,readChunk)",
    "documentation": "https://www.npmjs.com/package/mediainfo.js",
    "scope": "tracks+title",
    "family": "MediaInfoLib WASM",
    "family_note": "WebAssembly distribution of MediaInfoLib; same family as native MediaInfo."
  },
  {
    "name": "codem-isoboxer",
    "version": "0.3.10",
    "license": "MIT",
    "input_api": "ISOBoxer.parseBuffer(ArrayBuffer)",
    "documentation": "https://www.npmjs.com/package/codem-isoboxer",
    "scope": "boxes+brand",
    "family": "codem-isoboxer"
  },
  {
    "name": "mp4box",
    "version": "2.5.0",
    "license": "BSD-3-Clause",
    "input_api": "createFile().appendBuffer(ArrayBuffer with fileStart=0)",
    "documentation": "https://www.npmjs.com/package/mp4box",
    "scope": "tracks+brand",
    "family": "GPAC MP4Box.js",
    "family_note": "GPAC MP4Box.js parser family."
  },
  {
    "name": "mediabunny",
    "version": "1.65.2",
    "license": "MPL-2.0",
    "input_api": "Input({source:BufferSource(Uint8Array),formats:ALL_FORMATS}).getTracks()",
    "documentation": "https://www.npmjs.com/package/mediabunny",
    "scope": "tracks+duration",
    "family": "mediabunny"
  },
  {
    "name": "@audio/decode-mp4",
    "version": "1.3.1",
    "license": "MIT",
    "input_api": "decode(Uint8Array)",
    "documentation": "https://www.npmjs.com/package/@audio/decode-mp4",
    "scope": "audio_samples",
    "family": "@audio/decode-mp4",
    "family_note": "Decodes the AAC audio track within the MP4 control."
  },
  {
    "name": "jsmediatags",
    "version": "3.9.7",
    "license": "BSD-3-Clause",
    "input_api": "read(Uint8Array,{onSuccess,onError})",
    "documentation": "https://www.npmjs.com/package/jsmediatags",
    "scope": "tags",
    "family": "jsmediatags"
  },
  {
    "name": "mp4-box-encoding",
    "version": "1.4.1",
    "license": "MIT",
    "input_api": "decode(Buffer containing ftyp box)",
    "documentation": "https://www.npmjs.com/package/mp4-box-encoding",
    "scope": "ftyp",
    "family": "mp4-box-encoding",
    "family_note": "Parses the ftyp box only; narrow container-header scope."
  },
  {
    "name": "node-video-lib",
    "version": "2.5.0",
    "license": "MIT",
    "input_api": "MovieParser.parse(fileDescriptor)",
    "documentation": "https://www.npmjs.com/package/node-video-lib",
    "scope": "duration+tracks",
    "family": "node-video-lib"
  },
  {
    "name": "mp4-stream",
    "version": "3.1.3",
    "license": "MIT",
    "input_api": "decode().end(Buffer); box events",
    "documentation": "https://www.npmjs.com/package/mp4-stream",
    "scope": "box_headers",
    "family": "mp4-stream",
    "family_note": "Parses top-level MP4 box headers only in this control."
  }
]
