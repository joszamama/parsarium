      "elements": [
        "{urn:parsarium:catalog}catalog",
        "{urn:parsarium:item}item",
        "{urn:parsarium:item}item",
        "{urn:parsarium:item}name",
        "{urn:parsarium:item}note"
      ],
      "max_depth": 3,
      "root": "{urn:parsarium:catalog}catalog",
      "text": [
