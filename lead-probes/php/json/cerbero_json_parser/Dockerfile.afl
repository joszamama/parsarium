# Parser-line AFL++ bridge as generated by scripts/build_afl_bridge.py, over the lead image.
# Build from the repository root: docker build -f lead-probes/php/json/cerbero_json_parser/Dockerfile.afl .
FROM --platform=linux/arm64 parsarium-lead/json-php-cerbero_json_parser:local
RUN apt-get update -qq && apt-get install -y --no-install-recommends afl++=4.33c-1.1ubuntu1 clang \
    && rm -rf /var/lib/apt/lists/*
COPY fuzzing/afl-bridge/afl_proxy.c /work/afl_proxy.c
COPY fuzzing/afl-bridge/php_trace.php /work/afl_php_trace.php
COPY lead-probes/php/json/cerbero_json_parser/afl_trace /work/afl_trace
ENV PARSARIUM_SUBJECT_PREFIX=/work/vendor/cerbero/json-parser/
ENV PARSARIUM_PARSE_FUNCTION=parsarium_parse
RUN AFL_LLVM_INSTRUMENT=CLASSIC afl-clang-fast -O2 /work/afl_proxy.c -ldl -o /work/afl_proxy
ENTRYPOINT ["/work/afl_proxy"]
