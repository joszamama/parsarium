# Parser-line AFL++ bridge generated by scripts/build_afl_bridge.py
FROM --platform=linux/arm64 parsarium/mp3-javascript-mp3_duration:local
RUN apt-get update -qq && apt-get install -y --no-install-recommends afl++=4.21c-5 clang \
    && rm -rf /var/lib/apt/lists/*
COPY fuzzing/afl-bridge/afl_proxy.c /work/afl_proxy.c
COPY fuzzing/afl-bridge/javascript_child.js /work/afl_javascript_child.js
COPY fuzzing/afl-bridge/javascript_count_trace.js /work/afl_javascript_count_trace.js
COPY fuzzing/afl-native/mp3/javascript/mp3_duration/afl_trace /work/afl_trace
ENV PARSARIUM_SUBJECT_PREFIX=/work/node_modules/mp3-duration/index.js
ENV PARSARIUM_FUZZ_ENTRY=fuzz.js
ENV PARSARIUM_JS_COUNT_FUNCTIONS=parseFrameHeader,frameSize
RUN AFL_LLVM_INSTRUMENT=CLASSIC afl-clang-fast -O2 /work/afl_proxy.c -ldl -o /work/afl_proxy
ENTRYPOINT ["/work/afl_proxy"]
