# AFL++ overlay generated by scripts/build_afl_native.py
FROM ubuntu@sha256:065aa8626841f16057b78b027b464cd59c4fac36c204c72dcbf48d66f5fa8a96 AS build
RUN apt-get update -qq && apt-get install -y --no-install-recommends afl++=4.33c-1.1ubuntu1 python3 ca-certificates clang cmake curl libclang-rt-21-dev llvm make patch pkg-config python3 xz-utils zlib1g-dev \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /work
RUN curl --fail --location --retry 3 'https://get.videolan.org/vlc/3.0.24/vlc-3.0.24.tar.xz' -o /work/source.tar.xz \
 && echo 'e7cab503d1d7d5849b89d2cf0e1ee60d0ef6d012407791b644b9cfc0cc225fdf  /work/source.tar.xz' | sha256sum --check \
 && mkdir /work/source && tar -xJf /work/source.tar.xz -C /work/source --strip-components=1
# TagLib release pinned by VLC 3.0.24 contrib/src/taglib/rules.mak; the
# SHA-256 is of the archive whose SHA-512 matches contrib/src/taglib/SHA512SUMS.
RUN curl --fail --location --retry 3 'https://taglib.org/releases/taglib-1.13.1.tar.gz' -o /work/taglib.tar.gz \
 && echo 'c8da2b10f1bfec2cd7dbfcd33f4a2338db0765d851a50583d410bacf055cfd0b  /work/taglib.tar.gz' | sha256sum --check \
 && (cd /work/source/contrib/src/taglib && sha512sum /work/taglib.tar.gz | sed 's@/work/taglib.tar.gz@taglib-1.13.1.tar.gz@' | cmp - SHA512SUMS) \
 && tar -xzf /work/taglib.tar.gz -C /work
COPY harness.c harness.h replay.c build.sh /work/
RUN python3 -c 'from pathlib import Path; p=Path("/work/build.sh"); s=p.read_text(); s=s.replace("clang++","AFL_CXX").replace("clang","afl-clang-fast").replace("AFL_CXX","afl-clang-fast++").replace(",undefined",",undefined -fno-sanitize=function"); p.write_text(s)' && chmod +x /work/build.sh && /work/build.sh \
 && { clang --version | head -1; llvm-cov --version | head -1; cmake --version | head -1; } > /work/toolchain.txt
FROM ubuntu@sha256:065aa8626841f16057b78b027b464cd59c4fac36c204c72dcbf48d66f5fa8a96
ENV LLVM_PROFILE_FILE=/dev/null
RUN apt-get update -qq && apt-get install -y --no-install-recommends afl++=4.33c-1.1ubuntu1 python3 libstdc++6 llvm python3 zlib1g \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /work
COPY --from=build /work/replay /work/fuzzer /work/
COPY --from=build /work/toolchain.txt /work/toolchain.txt
COPY run-control.sh /work/run-control.sh
RUN chmod +x /work/run-control.sh
ENTRYPOINT ["/work/run-control.sh"]
