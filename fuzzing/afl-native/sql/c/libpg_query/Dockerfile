# AFL++ overlay generated by scripts/build_afl_native.py
FROM --platform=linux/arm64 ubuntu@sha256:065aa8626841f16057b78b027b464cd59c4fac36c204c72dcbf48d66f5fa8a96 AS build
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq && apt-get install -y --no-install-recommends afl++=4.33c-1.1ubuntu1 python3 ca-certificates clang curl libclang-rt-21-dev llvm make python3 && rm -rf /var/lib/apt/lists/*
WORKDIR /work
# libpg_query 18.1.0 release tag. The bison/flex outputs carry #line directives to gram.y and
# scan.l, which are not shipped; they are removed so coverage is attributed to the pinned C files.
RUN curl --fail --location --retry 3 https://codeload.github.com/pganalyze/libpg_query/tar.gz/refs/tags/18.1.0 --output /work/libpg_query.tar.gz \
    && echo '2d3486cf6a9d3955b53e66235db39d62b54216c820cd392ab66dc842c5b1316d  /work/libpg_query.tar.gz' | sha256sum --check \
    && tar -xf /work/libpg_query.tar.gz -C /work && mv /work/libpg_query-18.1.0 /work/libpg_query-src \
    && grep -q 'Redistribution and use in source and binary forms' /work/libpg_query-src/LICENSE \
    && sed -i '/^#line /d' /work/libpg_query-src/src/postgres/src_backend_parser_gram.c /work/libpg_query-src/src/postgres/src_backend_parser_scan.c
COPY harness.c parser-probe.c build.sh afl-allowlist.txt /work/
RUN python3 -c 'from pathlib import Path; p=Path("/work/build.sh"); s=p.read_text(); s=s.replace("clang++","AFL_CXX").replace("clang","afl-clang-fast").replace("AFL_CXX","afl-clang-fast++").replace(",undefined",",undefined -fno-sanitize=function"); p.write_text(s)' && chmod +x /work/build.sh && /work/build.sh \
    && { clang --version | head -1; llvm-cov --version | head -1; } > /work/toolchain.txt

FROM --platform=linux/arm64 ubuntu@sha256:065aa8626841f16057b78b027b464cd59c4fac36c204c72dcbf48d66f5fa8a96
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq && apt-get install -y --no-install-recommends afl++=4.33c-1.1ubuntu1 python3 llvm python3 && rm -rf /var/lib/apt/lists/*
WORKDIR /work
COPY --from=build /work/replay /work/fuzzer /work/parser-probe /work/afl-instrumented-objects.txt /work/
COPY --from=build /work/build-cov/src /work/build-cov/src
COPY --from=build /work/toolchain.txt /work/toolchain.txt
COPY run-control.sh summarize.py manifest.json /work/
RUN chmod +x /work/run-control.sh
ENTRYPOINT ["/work/run-control.sh"]
