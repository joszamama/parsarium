# Parser-line AFL++ bridge generated by scripts/build_afl_bridge.py
FROM --platform=linux/arm64 parsarium/sql-java-spark_catalyst:local
RUN apt-get update -qq && apt-get install -y --no-install-recommends afl++=4.33c-1.1ubuntu1 clang \
    && rm -rf /var/lib/apt/lists/*
COPY fuzzing/afl-bridge/afl_proxy.c /work/afl_proxy.c
COPY fuzzing/afl-bridge/JavaCase.java /work/JavaCase.java
COPY fuzzing/afl-bridge/java_trace.py /work/afl_java_trace.py
COPY fuzzing/afl-native/sql/java/spark_catalyst/afl_trace /work/afl_trace
ENV PARSARIUM_SUBJECT_PREFIX=/work/parser-source/
ENV PARSARIUM_FUZZ_ENTRY=SqlHarness.fuzzerTestOneInput
ENV PARSARIUM_JAVA_CLASSPATH=/work/classes:/work/lib/kryo-shaded-4.0.2.jar:/work/lib/commons-codec-1.16.1.jar:/work/lib/antlr4-runtime-4.9.3.jar:/work/lib/commons-lang3-3.12.0.jar:/work/lib/hadoop-client-api-3.3.4.jar:/work/lib/log4j-api-2.20.0.jar:/work/lib/log4j-core-2.20.0.jar:/work/lib/spark-catalyst_2.12-3.5.9.jar:/work/lib/spark-common-utils_2.12-3.5.9.jar:/work/lib/spark-core_2.12-3.5.9.jar:/work/lib/spark-network-common_2.12-3.5.9.jar:/work/lib/spark-sql-api_2.12-3.5.9.jar:/work/lib/spark-unsafe_2.12-3.5.9.jar:/work/lib/json4s-ast_2.12-3.7.0-M11.jar:/work/lib/scala-library-2.12.18.jar:/work/lib/scala-reflect-2.12.18.jar:/work/lib/slf4j-api-1.7.36.jar
ENV PARSARIUM_TARGET_CLASS=SqlHarness
ENV PARSARIUM_PARSER_JAR=/work/parser-classes
ENV PARSARIUM_PARSER_SOURCES=/work/parser-source
ENV PARSARIUM_JACOCO_INCLUDES=org.apache.spark.sql.catalyst.*
RUN mkdir /work/afl-java-classes && javac -d /work/afl-java-classes /work/JavaCase.java
RUN AFL_LLVM_INSTRUMENT=CLASSIC afl-clang-fast -O2 /work/afl_proxy.c -ldl -o /work/afl_proxy
ENTRYPOINT ["/work/afl_proxy"]
