# Parser-line AFL++ bridge generated by scripts/build_afl_bridge.py
FROM --platform=linux/arm64 parsarium/sql-java-trino_parser:local
RUN apt-get update -qq && apt-get install -y --no-install-recommends afl++=4.33c-1.1ubuntu1 clang \
    && rm -rf /var/lib/apt/lists/*
COPY fuzzing/afl-bridge/afl_proxy.c /work/afl_proxy.c
COPY fuzzing/afl-bridge/JavaCase.java /work/JavaCase.java
COPY fuzzing/afl-bridge/java_trace.py /work/afl_java_trace.py
COPY fuzzing/afl-native/sql/java/trino_parser/afl_trace /work/afl_trace
ENV PARSARIUM_SUBJECT_PREFIX=/work/parser-source/
ENV PARSARIUM_FUZZ_ENTRY=SqlHarness.fuzzerTestOneInput
ENV PARSARIUM_JAVA_CLASSPATH=/work/classes:/work/lib/error_prone_annotations-2.50.0.jar:/work/lib/failureaccess-1.0.3.jar:/work/lib/guava-33.7.2-jre.jar:/work/lib/j2objc-annotations-3.1.jar:/work/lib/trino-grammar-484.jar:/work/lib/trino-parser-484.jar:/work/lib/jakarta.annotation-api-3.0.0.jar:/work/lib/antlr4-runtime-4.13.2.jar:/work/lib/jspecify-1.0.1.jar
ENV PARSARIUM_TARGET_CLASS=SqlHarness
ENV PARSARIUM_PARSER_JAR=/work/parser-classes
ENV PARSARIUM_PARSER_SOURCES=/work/parser-source
ENV PARSARIUM_JACOCO_INCLUDES=io.trino.sql.*:io.trino.grammar.*
RUN mkdir /work/afl-java-classes && javac -d /work/afl-java-classes /work/JavaCase.java
RUN AFL_LLVM_INSTRUMENT=CLASSIC afl-clang-fast -O2 /work/afl_proxy.c -ldl -o /work/afl_proxy
ENTRYPOINT ["/work/afl_proxy"]
