# Parser-line AFL++ bridge generated by scripts/build_afl_bridge.py
FROM --platform=linux/arm64 parsarium/wav-java-jaudiotagger:local
RUN apt-get update -qq && apt-get install -y --no-install-recommends afl++=4.09c-1ubuntu3 clang \
    && rm -rf /var/lib/apt/lists/*
COPY fuzzing/afl-bridge/afl_proxy.c /work/afl_proxy.c
COPY fuzzing/afl-bridge/JavaCase.java /work/JavaCase.java
COPY fuzzing/afl-bridge/java_trace.py /work/afl_java_trace.py
COPY fuzzing/afl-native/wav/java/jaudiotagger/afl_trace /work/afl_trace
ENV PARSARIUM_SUBJECT_PREFIX=/work/parser-source/
ENV PARSARIUM_FUZZ_ENTRY=GenericHarness.fuzzerTestOneInput
ENV PARSARIUM_JAVA_CLASSPATH=/work/classes:/work/lib/wavfile-1.0.0.jar:/work/lib/apiguardian-api-1.0.0.jar:/work/lib/opentest4j-1.0.0.jar:/work/lib/surefire-api-2.19.1.jar:/work/lib/common-java5-2.19.1.jar:/work/lib/jaudiotagger-3.0.1.jar:/work/lib/jcodec-0.2.5.jar:/work/lib/beads-3.2.jar:/work/lib/jlayer-1.0.1.jar:/work/lib/mp3spi-1.9.5.4.jar:/work/lib/jlayer-1.0.1.4.jar:/work/lib/tritonus-share-0.3.7.4.jar:/work/lib/audioservers-javasound-2.0.0.jar:/work/lib/audioservers-api-2.0.0.jar:/work/lib/audioservers-jack-2.0.0.jar:/work/lib/jnajack-1.4.0.jar:/work/lib/jna-5.19.1.jar:/work/lib/codecmedia-1.2.2.jar:/work/lib/jdsp-3.1.1.jar:/work/lib/xchart-3.8.1.jar:/work/lib/VectorGraphics2D-0.13.jar:/work/lib/graphics2d-0.32.jar:/work/lib/pdfbox-2.0.24.jar:/work/lib/fontbox-2.0.24.jar:/work/lib/commons-logging-1.2.jar:/work/lib/animated-gif-lib-1.4.jar:/work/lib/ssj-3.3.1.jar:/work/lib/jfreechart-1.0.12.jar:/work/lib/jcommon-1.0.15.jar:/work/lib/colt-1.2.0.jar:/work/lib/concurrent-1.3.4.jar:/work/lib/optimization-1.3.jar:/work/lib/commons-math3-3.6.1.jar:/work/lib/iirj-1.5.jar:/work/lib/tika-parser-audiovideo-module-4.2.0.jar:/work/lib/vorbis-java-core-0.8.jar:/work/lib/tika-core-4.2.0.jar:/work/lib/slf4j-api-2.0.20.jar:/work/lib/commons-io-2.22.0.jar:/work/lib/commons-secure-xml-1.1.0.jar:/work/lib/commonmark-0.31.0.jar:/work/lib/commonmark-ext-gfm-tables-0.31.0.jar:/work/lib/commonmark-ext-gfm-strikethrough-0.31.0.jar:/work/lib/jhove-modules-1.20.1.jar:/work/lib/jhove-core-1.20.1.jar:/work/lib/musicg-1.4.2.2.jar:/work/lib/metadata-extractor-2.19.0.jar
ENV PARSARIUM_TARGET_CLASS=GenericHarness
ENV PARSARIUM_JACOCO_INCLUDES=*
ENV PARSARIUM_PARSER_JAR=/work/lib/jaudiotagger-3.0.1.jar
ENV PARSARIUM_PARSER_SOURCES=/work/parser-source
RUN mkdir /work/afl-java-classes && javac -d /work/afl-java-classes /work/JavaCase.java
RUN AFL_LLVM_INSTRUMENT=CLASSIC afl-clang-fast -O2 /work/afl_proxy.c -ldl -o /work/afl_proxy
ENTRYPOINT ["/work/afl_proxy"]
