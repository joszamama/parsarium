# Parser-line AFL++ bridge generated by scripts/build_afl_bridge.py
FROM --platform=linux/arm64 parsarium/yaml-java-zio_json_yaml:local
RUN apt-get update -qq && apt-get install -y --no-install-recommends afl++=4.33c-1.1ubuntu1 clang \
    && rm -rf /var/lib/apt/lists/*
COPY fuzzing/afl-bridge/afl_proxy.c /work/afl_proxy.c
COPY fuzzing/afl-bridge/JavaCase.java /work/JavaCase.java
COPY fuzzing/afl-bridge/java_dual_trace.py /work/afl_java_dual_trace.py
COPY fuzzing/afl-native/yaml/java/zio_json_yaml/afl_trace /work/afl_trace
ENV PARSARIUM_SUBJECT_PREFIX=/work/parser-source/module/
ENV PARSARIUM_FUZZ_ENTRY=GenericHarness.fuzzerTestOneInput
ENV PARSARIUM_JAVA_CLASSPATH=/work/classes:/work/lib/zio-json-yaml_2.13-1.1.2.jar:/work/lib/scala-library-2.13.18.jar:/work/lib/zio-json_2.13-1.1.2.jar:/work/lib/scala-collection-compat_2.13-2.14.0.jar:/work/lib/zio_2.13-2.1.27.jar:/work/lib/zio-streams_2.13-2.1.27.jar:/work/lib/zio-internal-macros_2.13-2.1.27.jar:/work/lib/zio-stacktracer_2.13-2.1.27.jar:/work/lib/izumi-reflect_2.13-3.0.11.jar:/work/lib/izumi-reflect-thirdparty-boopickle-shaded_2.13-3.0.11.jar:/work/lib/magnolia_2.13-1.1.14.jar:/work/lib/snakeyaml-2.7.jar
ENV PARSARIUM_TARGET_CLASS=GenericHarness
ENV PARSARIUM_PARSER_JAR=/work/lib/zio-json-yaml_2.13-1.1.2.jar
ENV PARSARIUM_PARSER_SOURCES=/work/parser-source/module
ENV PARSARIUM_JACOCO_INCLUDES=zio.json.yaml.*:org.yaml.snakeyaml.*
ENV PARSARIUM_UNDERLYING_JAR=/work/underlying-classes
ENV PARSARIUM_UNDERLYING_SOURCES=/work/parser-source/underlying
RUN mkdir /work/afl-java-classes && javac -d /work/afl-java-classes /work/JavaCase.java
RUN AFL_LLVM_INSTRUMENT=CLASSIC afl-clang-fast -O2 /work/afl_proxy.c -ldl -o /work/afl_proxy
ENTRYPOINT ["/work/afl_proxy"]
