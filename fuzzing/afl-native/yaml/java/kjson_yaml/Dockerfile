# Parser-line AFL++ bridge generated by scripts/build_afl_bridge.py
FROM --platform=linux/arm64 parsarium/yaml-java-kjson_yaml:local
RUN apt-get update -qq && apt-get install -y --no-install-recommends afl++=4.33c-1.1ubuntu1 clang \
    && rm -rf /var/lib/apt/lists/*
COPY fuzzing/afl-bridge/afl_proxy.c /work/afl_proxy.c
COPY fuzzing/afl-bridge/JavaCase.java /work/JavaCase.java
COPY fuzzing/afl-bridge/java_trace.py /work/afl_java_trace.py
COPY fuzzing/afl-native/yaml/java/kjson_yaml/afl_trace /work/afl_trace
ENV PARSARIUM_SUBJECT_PREFIX=/work/parser-source/
ENV PARSARIUM_FUZZ_ENTRY=GenericHarness.fuzzerTestOneInput
ENV PARSARIUM_JAVA_CLASSPATH=/work/classes:/work/lib/kjson-yaml-3.15.jar:/work/lib/kjson-core-10.2.jar:/work/lib/kjson-exception-1.3.jar:/work/lib/json-functions-2.1.jar:/work/lib/json-co-functions-2.0.jar:/work/lib/int-output-3.0.jar:/work/lib/co-int-output-3.0.jar:/work/lib/immutables-3.0.jar:/work/lib/kjson-pointer-8.12.jar:/work/lib/kjson-pointer-core-1.4.jar:/work/lib/textmatcher-3.1.jar:/work/lib/string-mapper-3.1.jar:/work/lib/pipelines-7.0.jar:/work/lib/log-front-kotlin-7.0.jar:/work/lib/log-front-7.0.jar:/work/lib/log-front-api-3.0.jar:/work/lib/kotlinx-coroutines-core-1.9.0.jar:/work/lib/kotlinx-coroutines-core-jvm-1.9.0.jar:/work/lib/kotlin-stdlib-jdk8-2.0.21.jar:/work/lib/kotlin-stdlib-2.0.21.jar:/work/lib/annotations-13.0.jar:/work/lib/kotlin-stdlib-jdk7-2.0.21.jar
ENV PARSARIUM_TARGET_CLASS=GenericHarness
ENV PARSARIUM_PARSER_JAR=/work/parser-classes
ENV PARSARIUM_PARSER_SOURCES=/work/parser-source
ENV PARSARIUM_JACOCO_INCLUDES=io.kjson.yaml.*
RUN mkdir /work/afl-java-classes && javac -d /work/afl-java-classes /work/JavaCase.java
RUN AFL_LLVM_INSTRUMENT=CLASSIC afl-clang-fast -O2 /work/afl_proxy.c -ldl -o /work/afl_proxy
ENTRYPOINT ["/work/afl_proxy"]
