# Parser-line AFL++ bridge generated by scripts/build_afl_bridge.py
FROM --platform=linux/arm64 parsarium/xml-php-symfony_dom_crawler:local
RUN apt-get update -qq && apt-get install -y --no-install-recommends afl++=4.33c-1.1ubuntu1 clang \
    && rm -rf /var/lib/apt/lists/*
COPY fuzzing/afl-bridge/afl_proxy.c /work/afl_proxy.c
COPY fuzzing/afl-bridge/php_trace.php /work/afl_php_trace.php
COPY fuzzing/afl-native/xml/php/symfony_dom_crawler/afl_trace /work/afl_trace
ENV PARSARIUM_SUBJECT_PREFIX=/work/vendor/symfony/dom-crawler/
ENV PARSARIUM_PARSE_FUNCTION=parsarium_parse
RUN AFL_LLVM_INSTRUMENT=CLASSIC afl-clang-fast -O2 /work/afl_proxy.c -ldl -o /work/afl_proxy
ENTRYPOINT ["/work/afl_proxy"]
