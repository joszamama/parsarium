# Python parser-line AFL++ bridge generated by scripts/build_afl_python.py
FROM --platform=linux/arm64 parsarium/xml-python-beautifulsoup4:local
RUN apt-get update -qq && apt-get install -y --no-install-recommends afl++=4.33c-1.1ubuntu1 clang \
    && rm -rf /var/lib/apt/lists/*
COPY fuzzing/afl-native/xml/python/beautifulsoup4/afl_proxy.c /work/afl_proxy.c
COPY fuzzing/afl-native/xml/python/beautifulsoup4/afl_start.c /work/afl_start.c
COPY fuzzing/afl-native/xml/python/beautifulsoup4/afl_python_trace.py /work/afl_python_trace.py
COPY fuzzing/afl-native/xml/python/beautifulsoup4/afl_trace /work/afl_trace
ENV PARSARIUM_SUBJECT_PREFIX=/opt/venv/lib/python3.14/site-packages/bs4/
ENV PARSARIUM_LLVM_MODULE_GLOB=/opt/libxml2/lib/libxml2.so.16

RUN clang -O2 -c /work/afl_proxy.c -o /work/afl_proxy.o && AFL_LLVM_INSTRUMENT=CLASSIC afl-clang-fast -O0 -c /work/afl_start.c -o /work/afl_start.o && AFL_LLVM_INSTRUMENT=CLASSIC afl-clang-fast /work/afl_proxy.o /work/afl_start.o -ldl -o /work/afl_proxy
ENTRYPOINT ["/work/afl_proxy"]
