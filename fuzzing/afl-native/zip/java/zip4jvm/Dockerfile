# Parser-line AFL++ bridge generated by scripts/build_afl_bridge.py
FROM --platform=linux/arm64 parsarium/zip-java-zip4jvm:local
RUN apt-get update -qq && apt-get install -y --no-install-recommends afl++=4.09c-1ubuntu3 clang \
    && rm -rf /var/lib/apt/lists/*
COPY fuzzing/afl-bridge/afl_proxy.c /work/afl_proxy.c
COPY fuzzing/afl-bridge/JavaCase.java /work/JavaCase.java
COPY fuzzing/afl-bridge/java_trace.py /work/afl_java_trace.py
COPY fuzzing/afl-native/zip/java/zip4jvm/afl_trace /work/afl_trace
ENV PARSARIUM_SUBJECT_PREFIX=/work/parser-source/
ENV PARSARIUM_FUZZ_ENTRY=GenericHarness.fuzzerTestOneInput
ENV PARSARIUM_JAVA_CLASSPATH=/work/classes:/work/lib/commons-compress-1.28.0.jar:/work/lib/commons-codec-1.19.0.jar:/work/lib/commons-io-2.20.0.jar:/work/lib/commons-lang3-3.18.0.jar:/work/lib/zip4j-2.11.6.jar:/work/lib/zt-zip-1.18.2.jar:/work/lib/slf4j-api-2.0.18.jar:/work/lib/lljzip-2.1.0.jar:/work/lib/jsr305-3.0.2.jar:/work/lib/ant-1.10.18.jar:/work/lib/ant-launcher-1.10.18.jar:/work/lib/commons-vfs2-2.10.0.jar:/work/lib/commons-logging-1.3.4.jar:/work/lib/zip4jvm-1.13.jar:/work/lib/zstd-jni-1.5.7-3.jar:/work/lib/xz-1.10.jar:/work/lib/quarkus-fs-util-1.4.2.jar:/work/lib/plexus-archiver-4.15.0.jar:/work/lib/javax.inject-1.jar:/work/lib/plexus-utils-3.6.2.jar:/work/lib/plexus-io-3.8.0.jar:/work/lib/jarchivelib-1.2.0.jar:/work/lib/compress4j-5.1.0.jar:/work/lib/jspecify-1.0.1.jar:/work/lib/arcana-1.1.0.jar:/work/lib/tika-parser-pkg-module-4.2.0.jar:/work/lib/dec-0.1.2.jar:/work/lib/tika-parser-zip-commons-4.2.0.jar:/work/lib/junrar-8.1.2.jar:/work/lib/tika-core-4.2.0.jar:/work/lib/commons-secure-xml-1.1.0.jar:/work/lib/commonmark-0.31.0.jar:/work/lib/commonmark-ext-gfm-tables-0.31.0.jar:/work/lib/commonmark-ext-gfm-strikethrough-0.31.0.jar:/work/lib/truezip-driver-zip-7.7.10.jar:/work/lib/truezip-swing-7.7.10.jar:/work/lib/annotations-3.0.0.jar:/work/lib/bcprov-jdk15on-1.52.jar:/work/lib/truezip-kernel-7.7.10.jar:/work/lib/truezip-driver-file-7.7.10.jar:/work/lib/truezip-file-7.7.10.jar:/work/lib/commons-archive-1.1.0.jar:/work/lib/truezip-utils-1.2.jar:/work/lib/truezip-driver-tar-7.7.5.jar:/work/lib/file-management-1.2.1.jar:/work/lib/commons-lang-2.4.jar:/work/lib/simplezip-2.2.jar:/work/lib/tinyzip-core-1.0.0.jar:/work/lib/sevenzipjbinding-23.01-2.2.jar:/work/lib/sevenzipjbinding-all-platforms-23.01-2.2.jar:/work/lib/truevfs-access-0.14.0.jar:/work/lib/truevfs-driver-file-0.14.0.jar:/work/lib/truevfs-kernel-spec-0.14.0.jar:/work/lib/service-wight-core-0.6.0.jar:/work/lib/truecommons-cio-2.5.0.jar:/work/lib/truecommons-io-2.5.0.jar:/work/lib/truevfs-kernel-impl-0