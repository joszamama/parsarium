# AFL++ overlay generated by scripts/build_afl_native.py
FROM --platform=linux/arm64 ubuntu@sha256:065aa8626841f16057b78b027b464cd59c4fac36c204c72dcbf48d66f5fa8a96 AS build
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq && apt-get install -y --no-install-recommends afl++=4.33c-1.1ubuntu1 python3 \
    ca-certificates clang cmake curl libclang-rt-21-dev llvm make pkg-config python3 \
    qt6-base-dev xz-utils zlib1g-dev \
    && rm -rf /var/lib/apt/lists/* \
    && test "$(dpkg-query -W -f='${Version}' qt6-base-dev)" = '6.10.2+dfsg-7' \
    && test "$(dpkg-query -W -f='${Version}' libqt6core6t64)" = '6.10.2+dfsg-7'
WORKDIR /work
# KArchive 6.31.0 requires ECM 6.31.0; Ubuntu 26.04 ships ECM 6.24.0. ECM is
# CMake modules only (LANGUAGES NONE), so nothing from it is compiled.
RUN curl --fail --location --retry 3 \
    https://download.kde.org/stable/frameworks/6.31/extra-cmake-modules-6.31.0.tar.xz \
    --output /work/ecm.tar.xz \
    && echo '8f74af329e4c918358bfe54316f8cf4d530c28444595a3e2fb15075f72877f17  /work/ecm.tar.xz' | sha256sum --check \
    && mkdir /work/ecm-source && tar -xJf /work/ecm.tar.xz -C /work/ecm-source --strip-components=1 \
    && rm /work/ecm.tar.xz \
    && cmake -S /work/ecm-source -B /work/ecm-build -DBUILD_TESTING=OFF -DBUILD_DOC=OFF \
       -DCMAKE_INSTALL_PREFIX=/work/ecm \
    && cmake --install /work/ecm-build \
    && rm -rf /work/ecm-source /work/ecm-build
RUN curl --fail --location --retry 3 \
