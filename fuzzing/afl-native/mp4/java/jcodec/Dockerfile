# Parser-line AFL++ bridge generated by scripts/build_afl_bridge.py
FROM --platform=linux/arm64 parsarium/mp4-java-jcodec:local
RUN apt-get update -qq && apt-get install -y --no-install-recommends afl++=4.09c-1ubuntu3 clang \
    && rm -rf /var/lib/apt/lists/*
COPY fuzzing/afl-bridge/afl_proxy.c /work/afl_proxy.c
COPY fuzzing/afl-bridge/JavaCase.java /work/JavaCase.java
COPY fuzzing/afl-bridge/java_trace.py /work/afl_java_trace.py
COPY fuzzing/afl-native/mp4/java/jcodec/afl_trace /work/afl_trace
ENV PARSARIUM_SUBJECT_PREFIX=/work/parser-source/
ENV PARSARIUM_FUZZ_ENTRY=GenericHarness.fuzzerTestOneInput
ENV PARSARIUM_JAVA_CLASSPATH=/work/classes:/work/lib/isoparser-1.9.56.jar:/work/lib/aspectjrt-1.9.7.jar:/work/lib/slf4j-api-1.8.0-beta4.jar:/work/lib/muxer-1.9.56.jar:/work/lib/junit-4.12.jar:/work/lib/hamcrest-core-1.3.jar:/work/lib/metadata-extractor-2.22.0.jar:/work/lib/xmpcore-6.1.11.jar:/work/lib/jcodec-0.2.5.jar:/work/lib/tika-parser-audiovideo-module-4.2.0.jar:/work/lib/vorbis-java-core-0.8.jar:/work/lib/tika-core-4.2.0.jar:/work/lib/commons-io-2.22.0.jar:/work/lib/commons-secure-xml-1.1.0.jar:/work/lib/commonmark-0.31.0.jar:/work/lib/commonmark-ext-gfm-tables-0.31.0.jar:/work/lib/commonmark-ext-gfm-strikethrough-0.31.0.jar:/work/lib/javacv-1.5.14.jar:/work/lib/ffmpeg-8.1.2-1.5.14.jar:/work/lib/javacpp-1.5.14.jar:/work/lib/ffmpeg-8.1.2-1.5.14-macosx-arm64.jar:/work/lib/javacpp-1.5.14-macosx-arm64.jar
ENV PARSARIUM_TARGET_CLASS=GenericHarness
ENV PARSARIUM_PARSER_JAR=/work/lib/jcodec-0.2.5.jar
ENV PARSARIUM_PARSER_SOURCES=/work/parser-source
ENV PARSARIUM_JACOCO_INCLUDES=*
RUN mkdir /work/afl-java-classes && javac -d /work/afl-java-classes /work/JavaCase.java
RUN AFL_LLVM_INSTRUMENT=CLASSIC afl-clang-fast -O2 /work/afl_proxy.c -ldl -o /work/afl_proxy
ENTRYPOINT ["/work/afl_proxy"]
