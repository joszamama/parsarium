# Parser-line AFL++ bridge generated by scripts/build_afl_bridge.py
FROM --platform=linux/arm64 parsarium/mp3_id3v2-java-jaudiotagger:local
RUN apt-get update -qq && apt-get install -y --no-install-recommends afl++=4.09c-1ubuntu3 clang \
    && rm -rf /var/lib/apt/lists/*
COPY fuzzing/afl-bridge/afl_proxy.c /work/afl_proxy.c
COPY fuzzing/afl-bridge/JavaCase.java /work/JavaCase.java
COPY fuzzing/afl-bridge/java_trace.py /work/afl_java_trace.py
COPY fuzzing/afl-native/mp3_id3v2/java/jaudiotagger/afl_trace /work/afl_trace
ENV PARSARIUM_SUBJECT_PREFIX=/work/parser-sources/org/jaudiotagger/
ENV PARSARIUM_FUZZ_ENTRY=JaudiotaggerHarness.fuzzerTestOneInput
ENV PARSARIUM_JAVA_CLASSPATH=/work/classes:/work/parser.jar
ENV PARSARIUM_TARGET_CLASS=JaudiotaggerHarness
ENV PARSARIUM_JACOCO_INCLUDES=org.jaudiotagger.*
ENV PARSARIUM_PARSER_JAR=/work/parser.jar
ENV PARSARIUM_PARSER_SOURCES=/work/parser-sources
RUN mkdir /work/afl-java-classes && javac -d /work/afl-java-classes /work/JavaCase.java
RUN AFL_LLVM_INSTRUMENT=CLASSIC afl-clang-fast -O2 /work/afl_proxy.c -ldl -o /work/afl_proxy
ENTRYPOINT ["/work/afl_proxy"]
