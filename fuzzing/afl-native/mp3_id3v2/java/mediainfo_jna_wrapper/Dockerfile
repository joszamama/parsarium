# Parser-line AFL++ bridge generated by scripts/build_afl_bridge.py
FROM --platform=linux/arm64 parsarium/mp3_id3v2-java-mediainfo_jna_wrapper:local
RUN apt-get update -qq && apt-get install -y --no-install-recommends afl++=4.33c-1.1ubuntu1 clang \
    && rm -rf /var/lib/apt/lists/*
COPY fuzzing/afl-bridge/afl_proxy.c /work/afl_proxy.c
COPY fuzzing/afl-bridge/JavaCase.java /work/JavaCase.java
COPY fuzzing/afl-bridge/java_trace.py /work/afl_java_trace.py
COPY fuzzing/afl-native/mp3_id3v2/java/mediainfo_jna_wrapper/afl_trace /work/afl_trace
ENV PARSARIUM_SUBJECT_PREFIX=/work/parser-source/
ENV PARSARIUM_FUZZ_ENTRY=GenericHarness.fuzzerTestOneInput
ENV PARSARIUM_JAVA_CLASSPATH=/work/classes:/work/lib/slf4j-nop-2.0.20.jar:/work/lib/slf4j-api-2.0.20.jar:/work/lib/mediainfo-jna-wrapper-2.1.9.jar:/work/lib/jna-platform-5.19.1.jar:/work/lib/jna-5.19.1.jar:/work/lib/mediainfo-jna-lib-mac-aarch64-2.1.9.jar
ENV PARSARIUM_TARGET_CLASS=GenericHarness
ENV PARSARIUM_JACOCO_INCLUDES=*
ENV PARSARIUM_PARSER_JAR=/work/lib/mediainfo-jna-wrapper-2.1.9.jar
ENV PARSARIUM_PARSER_SOURCES=/work/parser-source
RUN mkdir /work/afl-java-classes && javac -d /work/afl-java-classes /work/JavaCase.java
RUN AFL_LLVM_INSTRUMENT=CLASSIC afl-clang-fast -O2 /work/afl_proxy.c -ldl -o /work/afl_proxy
ENTRYPOINT ["/work/afl_proxy"]
