# Parser-line AFL++ bridge generated by scripts/build_afl_bridge.py
FROM --platform=linux/arm64 parsarium/mp3_id3v2-java-taglib_java:local
RUN apt-get update -qq && apt-get install -y --no-install-recommends afl++=4.33c-1.1ubuntu1 clang \
    && rm -rf /var/lib/apt/lists/*
COPY fuzzing/afl-bridge/afl_proxy.c /work/afl_proxy.c
COPY fuzzing/afl-bridge/JavaCase.java /work/JavaCase.java
COPY fuzzing/afl-bridge/java_trace.py /work/afl_java_trace.py
COPY fuzzing/afl-native/mp3_id3v2/java/taglib_java/afl_trace /work/afl_trace
ENV PARSARIUM_SUBJECT_PREFIX=/work/parser-source/
ENV PARSARIUM_FUZZ_ENTRY=GenericHarness.fuzzerTestOneInput
ENV PARSARIUM_JAVA_CLASSPATH=/work/classes:/work/lib/jaudiotagger-3.0.1.jar:/work/lib/mp3agic-0.9.1.jar:/work/lib/tika-parser-audiovideo-module-4.2.0.jar:/work/lib/metadata-extractor-2.22.0.jar:/work/lib/xmpcore-6.1.11.jar:/work/lib/vorbis-java-core-0.8.jar:/work/lib/tika-core-4.2.0.jar:/work/lib/slf4j-api-2.0.20.jar:/work/lib/commons-io-2.22.0.jar:/work/lib/commons-secure-xml-1.1.0.jar:/work/lib/commonmark-0.31.0.jar:/work/lib/commonmark-ext-gfm-tables-0.31.0.jar:/work/lib/commonmark-ext-gfm-strikethrough-0.31.0.jar:/work/lib/slf4j-nop-2.0.20.jar:/work/lib/jlayer-1.0.1.jar:/work/lib/jave-core-4.2.0.jar:/work/lib/jave-nativebin-osxm1-4.2.0.jar:/work/lib/jaffree-2024.08.29.jar:/work/lib/nanojson-1.9.jar:/work/lib/jcodec-0.2.5.jar:/work/lib/codecmedia-1.2.2.jar:/work/lib/jid3lib-0.5.4.jar:/work/lib/taglib-1.0.0.jar:/work/lib/javamp3-1.0.1.jar
ENV PARSARIUM_TARGET_CLASS=GenericHarness
ENV PARSARIUM_JACOCO_INCLUDES=*
ENV PARSARIUM_PARSER_JAR=/work/lib/taglib-1.0.0.jar
ENV PARSARIUM_PARSER_SOURCES=/work/parser-source
RUN mkdir /work/afl-java-classes && javac -d /work/afl-java-classes /work/JavaCase.java
RUN AFL_LLVM_INSTRUMENT=CLASSIC afl-clang-fast -O2 /work/afl_proxy.c -ldl -o /work/afl_proxy
ENTRYPOINT ["/work/afl_proxy"]
