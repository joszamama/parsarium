# AFL++ overlay generated by scripts/build_afl_native.py
FROM ubuntu@sha256:065aa8626841f16057b78b027b464cd59c4fac36c204c72dcbf48d66f5fa8a96 AS build
RUN apt-get update -qq && apt-get install -y --no-install-recommends afl++=4.33c-1.1ubuntu1 python3 bison bzip2 ca-certificates clang curl flex libclang-rt-21-dev libavcodec-dev libavfilter-dev libavformat-dev libavutil-dev libglib2.0-dev libswresample-dev llvm meson ninja-build pkg-config python3 \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /work
RUN curl --fail --location --retry 3 'https://gitlab.freedesktop.org/gstreamer/gstreamer/-/archive/1.28.9/gstreamer-1.28.9.tar.bz2' -o /work/source.tar.bz2 \
 && echo '6f4074f5bdd071a074220a3642b5861410aa6929c179d903feff4af82d9a05d7  /work/source.tar.bz2' | sha256sum --check \
 && mkdir /work/source && tar -xjf /work/source.tar.bz2 -C /work/source --strip-components=1
COPY build-source.sh /work/build-source.sh
RUN python3 -c 'from pathlib import Path; p=Path("/work/build-source.sh"); s=p.read_text().replace("clang","afl-clang-fast"); p.write_text(s)' && chmod +x /work/build-source.sh && /work/build-source.sh
COPY harness.c harness.h replay.c build.sh /work/
RUN python3 -c 'from pathlib import Path; p=Path("/work/build.sh"); s=p.read_text(); s=s.replace("clang++","AFL_CXX").replace("clang","afl-clang-fast").replace("AFL_CXX","afl-clang-fast++").replace(",undefined",",undefined -fno-sanitize=function"); p.write_text(s)' && chmod +x /work/build.sh && /work/build.sh \
 && { clang --version | head -1; llvm-cov --version | head -1; } > /work/toolchain.txt
FROM ubuntu@sha256:065aa8626841f16057b78b027b464cd59c4fac36c204c72dcbf48d66f5fa8a96
RUN apt-get update -qq && apt-get install -y --no-install-recommends afl++=4.33c-1.1ubuntu1 python3 libavcodec62 libavfilter11 libavformat62 libavutil60 libglib2.0-0t64 libswresample6 llvm python3 libstdc++6 \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /work
COPY --from=build /work/replay /work/fuzzer /work/
COPY --from=build /work/source /work/source
COPY --from=build /work/install /work/install
COPY --from=build /work/toolchain.txt /work/toolchain.txt
COPY run-control.sh /work/run-control.sh
ENV LD_LIBRARY_PATH=/work/install/lib
ENV GST_PLUGIN_PATH=/work/install/lib/gstreamer-1.0
ENV GST_PLUGIN_SYSTEM_PATH=/work/install/lib/gstreamer-1.0
ENV GST_REGISTRY_FORK=no
ENV GST_REGISTRY=/tmp/parsarium-gst-registry.bin
RUN chmod +x /work/run-control.sh
ENTRYPOINT ["/work/run-control.sh"]

ENV AFL_PRELOAD=/work/install/lib/gstreamer-1.0/libgstapp.so:/work/install/lib/gstreamer-1.0/libgstaudioconvert.so:/work/install/lib/gstreamer-1.0/libgstaudioparsers.so:/work/install/lib/gstreamer-1.0/libgstcoreelements.so:/work/install/lib/gstreamer-1.0/libgstid3demux.so:/work/install/lib/gstreamer-1.0/libgstisomp4.so:/work/install/lib/gstreamer-1.0/libgstplayback.so:/work/install/lib/gstreamer-1.0/libgstpnm.so:/work/install/lib/gstreamer-1.0/libgsttypefindfunctions.so:/work/install/lib/gstreamer-1.0/libgstwavparse.so:/work/install/lib/gstreamer-1.0/libgstlibav.so
