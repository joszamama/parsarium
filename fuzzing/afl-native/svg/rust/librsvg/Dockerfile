# AFL++ Rust overlay generated by scripts/build_afl_rust.py
FROM rust@sha256:8a4e90c7946b74626488b1446f712c0fe0ed1a596cbd3d871684bc9c5433ae07 AS build
RUN apt-get update -qq && apt-get install -y --no-install-recommends clang llvm-dev g++ make python3 pkg-config libglib2.0-dev libgdk-pixbuf-2.0-dev libcairo2-dev libpango1.0-dev \
    && rm -rf /var/lib/apt/lists/*
RUN cargo install cargo-afl --version 0.18.2 --locked
WORKDIR /work
COPY fuzzing/afl-native/svg/rust/librsvg/Cargo.toml fuzzing/afl-native/svg/rust/librsvg/Cargo.lock /work/
COPY projects/svg/rust/librsvg/src /work/src
COPY fuzzing/afl-native/svg/rust/librsvg/afl_fuzzer.rs /work/src/bin/afl_fuzzer.rs
RUN cargo fetch --locked --target aarch64-unknown-linux-gnu
RUN cargo afl config --build --force \
    && cargo afl build --locked --target aarch64-unknown-linux-gnu --release --bin afl_fuzzer \
    && cp target/aarch64-unknown-linux-gnu/release/afl_fuzzer /work/afl_fuzzer
FROM debian@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2
RUN apt-get update -qq && apt-get install -y --no-install-recommends afl++=4.21c-5 libstdc++6 librsvg2-2 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /work/afl_fuzzer /work/afl_fuzzer
ENTRYPOINT ["/work/afl_fuzzer"]
