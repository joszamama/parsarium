# AFL++ overlay generated by scripts/build_afl_native.py
FROM --platform=linux/arm64 ubuntu@sha256:c4ca31b6e93261c5dd773826f789738a49e414ca04fc094b1ccd0f91e07329a2 AS build
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq && apt-get install -y --no-install-recommends afl++=4.33c-1.1ubuntu1 python3 \
    ca-certificates clang curl libclang-rt-dev libclang-rt-21-dev libdrm-dev \
    libgtk-4-dev llvm meson ninja-build \
    pkg-config python3 xz-utils \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /work
RUN curl --fail --location --retry 3 \
    https://download.gnome.org/sources/gtk/4.24/gtk-4.24.1.tar.xz \
    --output /work/gtk-4.24.1.tar.xz \
    && echo 'e98abe720e16129c8c0f50761dee0a2e9ae2478055e31018f6cf977fcf6513e9  /work/gtk-4.24.1.tar.xz' | sha256sum --check \
    && mkdir /work/source \
    && tar -xJf /work/gtk-4.24.1.tar.xz -C /work/source --strip-components=1 \
    && echo '36595f02af8650a755e2b70c5ffffce26c436560c07da87ec629d833c1826512  /work/source/gtk/svg/gtksvgparser.c' | sha256sum --check \
    && echo '3cf0be0fa050c551382854f2111930cdf21f930c4e7d62573e1eb9f31a98ecf9  /work/source/gtk/svg/gtksvg.c' | sha256sum --check
COPY harness.h harness.c replay.c build.sh afl-allowlist.txt /work/
ENV AFL_LLVM_ALLOWLIST=/work/afl-allowlist.txt
RUN python3 -c 'from pathlib import Path; p=Path("/work/build.sh"); s=p.read_text(); s=s.replace("clang++","AFL_CXX").replace("clang","afl-clang-fast").replace("AFL_CXX","afl-clang-fast++").replace(",undefined",",undefined -fno-sanitize=function"); p.write_text(s)' && chmod +x /work/build.sh && /work/build.sh \
    && { clang --version | head -1; llvm-cov --version | head -1; pkg-config --modversion glib-2.0 pango gtk4; } > /work/toolchain.txt

FROM --platform=linux/arm64 ubuntu@sha256:c4ca31b6e93261c5dd773826f789738a49e414ca04fc094b1ccd0f91e07329a2
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq && apt-get install -y --no-install-recommends afl++=4.33c-1.1ubuntu1 python3 \
    libgtk-4-1 llvm python3 xvfb \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /work
COPY --from=build /work/replay-bin /work/fuzzer-bin /work/
COPY --from=build /work/build/gtk/libgtk-4.so* /work/lib/
COPY --from=build /work/toolchain.txt /work/toolchain.txt
COPY with-display.sh replay.sh fuzzer.sh run-control.sh /work/
RUN chmod +x /work/with-display.sh /work/replay.sh /work/fuzzer.sh /work/run-control.sh \
    && ln -s /work/replay.sh /work/replay \
    && ln -s /work/fuzzer.sh /work/fuzzer
ENV LD_LIBRARY_PATH=/work/lib LLVM_PROFILE_FILE=/dev/null ASAN_OPTIONS=detect_leaks=0
ENTRYPOINT ["/work/run-control.sh"]
