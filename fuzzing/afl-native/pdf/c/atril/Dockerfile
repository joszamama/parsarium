# AFL++ overlay generated by scripts/build_afl_native.py
FROM --platform=linux/arm64 ubuntu@sha256:065aa8626841f16057b78b027b464cd59c4fac36c204c72dcbf48d66f5fa8a96 AS build
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq && apt-get install -y --no-install-recommends afl++=4.33c-1.1ubuntu1 python3 \
    ca-certificates clang cmake curl gettext itstool libclang-rt-21-dev libcairo2-dev \
    libarchive-dev libfreetype-dev libgail-3-dev libglib2.0-dev libglib2.0-dev-bin libgtk-3-dev libice-dev \
    libmate-desktop-dev libsm-dev libx11-dev libxml2-dev libxml2-utils llvm make ninja-build \
    pkg-config python3 shared-mime-info xz-utils zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /work
RUN curl --fail --location --retry 3 https://poppler.freedesktop.org/poppler-26.11.0.tar.xz -o /work/poppler.tar.xz \
    && echo '41c32680160addf5a8dd7a830e4869c01e9f6bee1abb91e44fabd1ba9d7828fb  /work/poppler.tar.xz' | sha256sum --check \
    && mkdir /work/source && tar -xJf /work/poppler.tar.xz -C /work/source --strip-components=1 \
    && curl --fail --location --retry 3 https://github.com/mate-desktop/atril/releases/download/v1.28.2/atril-1.28.2.tar.xz -o /work/atril.tar.xz \
    && echo '0b1b2bdd3798d4c953c85552985d1118ee4cf7a10acb149df570d6e80feecfef  /work/atril.tar.xz' | sha256sum --check \
    && mkdir /work/atril-source && tar -xJf /work/atril.tar.xz -C /work/atril-source --strip-components=1
COPY source-lock.json check-source.py /work/
RUN python3 -I /work/check-source.py /work/source-lock.json /work/atril-source /work/source
COPY harness.h harness.c replay.c build.sh afl-allowlist.txt /work/
ENV AFL_LLVM_ALLOWLIST=/work/afl-allowlist.txt PKG_CONFIG_PATH=/work/install/lib/pkgconfig
RUN python3 -c 'from pathlib import Path; p=Path("/work/build.sh"); s=p.read_text(); s=s.replace("clang++","AFL_CXX").replace("clang","afl-clang-fast").replace("AFL_CXX","afl-clang-fast++").replace(",undefined",",undefined -fno-sanitize=function"); p.write_text(s)' && chmod +x /work/build.sh && /work/build.sh \
    && { clang --version | head -1; llvm-cov --version | head -1; pkg-config --modversion poppler-glib atril-document-1.5.0; } > /work/toolchain.txt

FROM --platform=linux/arm64 ubuntu@sha256:065aa8626841f16057b78b027b464cd59c4fac36c204c72dcbf48d66f5fa8a96
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq && apt-get install -y --no-install-recommends afl++=4.33c-1.1ubuntu1 python3 \
    libgtk-3-dev libxml2-dev libstdc++6 llvm python3 shared-mime-info \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /work
COPY --from=build /work/replay /work/fuzzer /work/
COPY --from=build /work/install/lib /work/install/lib
COPY --from=build /work/toolchain.txt /work/toolchain.txt
COPY run-control.sh valid-one-page.pdf /work/
ENV LD_LIBRARY_PATH=/work/install/lib EV_BACKENDS_DIR=/work/install/lib/atril/3/backends LLVM_PROFILE_FILE=/dev/null \
    AFL_PRELOAD=/work/install/lib/atril/3/backends/libpdfdocument.so
RUN chmod +x /work/run-control.sh
ENTRYPOINT ["/work/run-control.sh"]
