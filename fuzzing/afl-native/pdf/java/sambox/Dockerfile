ENV PARSARIUM_JAVA_CLASSPATH=/work/classes:/work/lib/pdfbox-3.0.8.jar:/work/lib/pdfbox-io-3.0.8.jar:/work/lib/fontbox-3.0.8.jar:/work/lib/commons-logging-1.4.0.jar:/work/lib/itextpdf-5.5.13.jar:/work/lib/openpdf-3.0.5.jar:/work/lib/brotli4j-1.23.0.jar:/work/lib/service-1.23.0.jar:/work/lib/native-osx-aarch64-1.23.0.jar:/work/lib/kernel-9.8.0.jar:/work/lib/io-9.8.0.jar:/work/lib/commons-9.8.0.jar:/work/lib/jackson-databind-2.22.3.jar:/work/lib/jackson-annotations-2.22.jar:/work/lib/jackson-core-2.22.3.jar:/work/lib/bouncy-castle-connector-9.8.0.jar:/work/lib/slf4j-api-2.0.16.jar:/work/lib/tika-parser-pdf-module-4.2.0.jar:/work/lib/tika-parser-xmp-commons-4.2.0.jar:/work/lib/pdfbox-tools-3.0.8.jar:/work/lib/picocli-4.7.7.jar:/work/lib/bcjmail-jdk18on-1.86.jar:/work/lib/bcpkix-jdk18on-1.86.jar:/work/lib/bcutil-jdk18on-1.86.jar:/work/lib/bcprov-jdk18on-1.86.jar:/work/lib/tika-core-4.2.0.jar:/work/lib/commons-io-2.22.0.jar:/work/lib/commons-secure-xml-1.1.0.jar:/work/lib/commonmark-0.31.0.jar:/work/lib/commonmark-ext-gfm-tables-0.31.0.jar:/work/lib/commonmark-ext-gfm-strikethrough-0.31.0.jar:/work/lib/pdfjet-9.1.7.jar:/work/lib/icepdf-core-6.2.2.jar:/work/lib/bcprov-jdk15on-1.54.jar:/work/lib/bcprov-ext-jdk15on-1.54.jar:/work/lib/bcpkix-jdk15on-1.54.jar:/work/lib/jai_imageio-1.1.pom:/work/lib/preflight-3.0.8.jar:/work/lib/xmpbox-3.0.8.jar:/work/lib/openpdf-renderer-3.0.5.jar:/work/lib/parser-1.30.4.jar:/work/lib/pdfviewfx-3.6.1.jar:/work/lib/javafx-controls-23.0.2.jar:/work/lib/javafx-controls-23.0.2-mac-aarch64.jar:/work/lib/javafx-graphics-23.0.2.jar:/work/lib/javafx-graphics-23.0.2-mac-aarch64.jar:/work/lib/javafx-base-23.0.2.jar:/work/lib/javafx-base-23.0.2-mac-aarch64.jar:/work/lib/javafx-swing-23.0.2.jar:/work/lib/javafx-swing-23.0.2-mac-aarch64.jar:/work/lib/controlsfx-11.2.4.jar:/work/lib/ikonli-core-12.4.0.jar:/work/lib/ikonli-materialdesign-pack-12.4.0.jar:/work/lib/ikonli-javafx-12.4.0.jar:/work/lib/commons-lang3-3.20.0.jar:/work/lib/sambox-4.0.0.M8.jar:/work/