# Python parser-line AFL++ bridge generated by scripts/build_afl_python.py
FROM --platform=linux/amd64 parsarium/http11-python-http_parser:local
RUN apt-get update -qq && apt-get install -y --no-install-recommends afl++=4.04c-4 clang \
    && rm -rf /var/lib/apt/lists/*
COPY fuzzing/afl-bridge/afl_proxy.c /work/afl_proxy.c
COPY fuzzing/afl-bridge/python_llvm_native_trace.py /work/afl_python_trace.py
COPY fuzzing/afl-native/http11/python/http_parser/afl_trace /work/afl_trace
ENV PARSARIUM_SUBJECT_PREFIX=/work/source/http_parser/
ENV PARSARIUM_LLVM_MODULE_GLOB=/opt/venv/lib/python3.10/site-packages/http_parser/parser.cpython-*.so

RUN AFL_LLVM_INSTRUMENT=CLASSIC afl-clang-fast -O2 /work/afl_proxy.c -ldl -o /work/afl_proxy
ENTRYPOINT ["/work/afl_proxy"]
