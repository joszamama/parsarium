# AFL++ overlay generated by scripts/build_afl_native.py
FROM --platform=linux/arm64 ubuntu@sha256:065aa8626841f16057b78b027b464cd59c4fac36c204c72dcbf48d66f5fa8a96 AS build
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq && apt-get install -y --no-install-recommends afl++=4.33c-1.1ubuntu1 python3 \
    ca-certificates clang curl libclang-rt-21-dev llvm python3 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /work
RUN curl --fail --location --retry 3 \
    https://github.com/LiangliangNan/Easy3D/archive/refs/tags/v2.6.1.tar.gz \
    --output /work/Easy3D-2.6.1.tar.gz \
    && echo 'e5b5355d042d997d65958c44b80073d37b8c3972bacbb97913e824a8597d9671  /work/Easy3D-2.6.1.tar.gz' | sha256sum --check \
    && mkdir /work/source \
    && tar -xf /work/Easy3D-2.6.1.tar.gz -C /work/source --strip-components=1 \
    && cd /work/source && printf '%s\n' \
    '4adca31e9a698acea15beaf59b4bb10adee564f2f4737fb9207ca96f71babf47  easy3d/fileio/surface_mesh_io.h' \
    '69f688bddbabd02cb5839b0e0b9f0a000d91197b677ec3f66cfd6c09f9026829  easy3d/fileio/surface_mesh_io.cpp' \
    '3695e98f69a3f81ff418f54c3103bcaf6c3706b2502504e8aefc06787a697767  easy3d/fileio/surface_mesh_io_ply.cpp' \
    '5a792d91bf120885a05683434c3081ab0e62bb8b2a0e8ba5c14e6f5ed43137f0  easy3d/fileio/ply_reader_writer.cpp' \
    '3ecc519eb68b5caf77c4dea75cf042a50bfcad4bc8d81de27db08d6ea5f1b9ea  3rd_party/rply/rply.h' \
    '0f4473e0cad7fa56c4c6372b1ffa641dfe628451cdac0cfb63fc6902797acce9  3rd_party/rply/rply.c' \
    '8ceb4b9ee5adedde47b31e975c1d90c73ad27b6b165a1dcd80c7c545eb65b903  LICENSE' \
    | sha256sum --check
COPY harness.h harness.cpp replay.cpp fuzz.cpp build.sh /work/
RUN python3 -c 'from pathlib import Path; p=Path("/work/build.sh"); s=p.read_text(); s=s.replace("clang++","AFL_CXX").replace("clang","afl-clang-fast").replace("AFL_CXX","afl-clang-fast++").replace(",undefined",",undefined -fno-sanitize=function"); p.write_text(s)' && chmod +x /work/build.sh && /work/build.sh \
    && { clang++ --version | head -1; llvm-cov --version | head -1; } > /work/toolchain.txt

FROM --platform=linux/arm64 ubuntu@sha256:065aa8626841f16057b78b027b464cd59c4fac36c204c72dcbf48d66f5fa8a96
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq && apt-get install -y --no-install-recommends afl++=4.33c-1.1ubuntu1 python3 \
    llvm python3 libstdc++6 && rm -rf /var/lib/apt/lists/*
WORKDIR /work
COPY --from=build /work/replay /work/fuzzer /work/
COPY --from=build /work/source /work/source
COPY --from=build /work/toolchain.txt /work/toolchain.txt
COPY run-control.sh /work/run-control.sh
RUN chmod +x /work/run-control.sh
ENTRYPOINT ["/work/run-control.sh"]
