# AFL++ overlay generated by scripts/build_afl_native.py
FROM --platform=linux/arm64 ubuntu@sha256:065aa8626841f16057b78b027b464cd59c4fac36c204c72dcbf48d66f5fa8a96 AS build
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq && apt-get install -y --no-install-recommends afl++=4.33c-1.1ubuntu1 python3 \
    ca-certificates clang cmake curl libclang-rt-21-dev llvm make python3 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /work
RUN curl --fail --location --retry 3 \
    https://www.vtk.org/files/release/9.7/VTK-9.7.2.tar.gz \
    --output /work/VTK-9.7.2.tar.gz \
    && echo 'fecef55df5caec6298ce190024060a90ce3bb515033c0f18968b9ab5c12bf796  /work/VTK-9.7.2.tar.gz' | sha256sum --check \
    && mkdir /work/source \
    && tar -xf /work/VTK-9.7.2.tar.gz -C /work/source --strip-components=1 \
    && rm /work/VTK-9.7.2.tar.gz \
    && cd /work/source && printf '%s\n' \
    '3d07d5aaf2c4fe9114a8910644eb3c1491306b52ebb8bd92e4bc452459c87bfe  IO/PLY/vtkPLYReader.h' \
    'b13d4703d291fd48ffb329024748bf009add5667a0383172593f8d1ae0fec0b4  IO/PLY/vtkPLYReader.cxx' \
    'a9524f2714bf669816f3e70295e95a963f684a1755ada461e12b8cd188db93d6  IO/PLY/vtkPLY.h' \
    '9a76a055c85797a1e52fb2ee78198265270f39a2d7092ac3f481adef5d28061b  IO/PLY/vtkPLY.cxx' \
    'f986802c1b8a0498fdf559c65877b760422468c1bf9ca8243ae959e97f7530c1  IO/PLY/Copyright.txt' \
    '11232448be82e0ea2c2c66219c2e36389f42249894070ee10c549ff182fc08b6  Copyright.txt' \
    | sha256sum --check
COPY harness.h harness.cpp replay.cpp fuzz.cpp build.sh /work/
RUN python3 -c 'from pathlib import Path; p=Path("/work/build.sh"); s=p.read_text(); s=s.replace("clang++","AFL_CXX").replace("clang","afl-clang-fast").replace("AFL_CXX","afl-clang-fast++").replace(",undefined",",undefined -fno-sanitize=function"); p.write_text(s)' && chmod +x /work/build.sh && /work/build.sh \
    && { clang++ --version | head -1; llvm-cov --version | head -1; cmake --version | head -1; } > /work/toolchain.txt

FROM --platform=linux/arm64 ubuntu@sha256:065aa8626841f16057b78b027b464cd59c4fac36c204c72dcbf48d66f5fa8a96
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq && apt-get install -y --no-install-recommends afl++=4.33c-1.1ubuntu1 python3 \
    llvm python3 libstdc++6 && rm -rf /var/lib/apt/lists/*
WORKDIR /work
COPY --from=build /work/replay /work/fuzzer /work/
COPY --from=build /work/source/IO/PLY /work/source/IO/PLY
COPY --from=build /work/source/Copyright.txt /work/source/Copyright.txt
COPY --from=build /work/toolchain.txt /work/toolchain.txt
COPY run-control.sh /work/run-control.sh
RUN chmod +x /work/run-control.sh
ENTRYPOINT ["/work/run-control.sh"]
