# Parser-line AFL++ bridge generated by scripts/build_afl_bridge.py
FROM --platform=linux/arm64 debian@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc
RUN apt-get update -qq && apt-get install -y --no-install-recommends afl++=4.04c-4 clang python3 libassimp5 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=parsarium/ascii_ply-go-github_com_bhaumiktalwar_assimp_go_asig:local /work/harness.test /work/harness.test
COPY fuzzing/afl-bridge/afl_proxy.c /work/afl_proxy.c
COPY fuzzing/afl-bridge/go_trace.py /work/afl_go_trace.py
COPY fuzzing/afl-native/ascii_ply/go/github_com_bhaumiktalwar_assimp_go_asig/afl_trace /work/afl_trace
ENV PARSARIUM_SUBJECT_PREFIX=github.com/BhaumikTalwar/assimp-go/asig/
ENV PARSARIUM_FUZZ_ENTRY=FuzzParser
RUN AFL_LLVM_INSTRUMENT=CLASSIC afl-clang-fast -O2 /work/afl_proxy.c -ldl -o /work/afl_proxy
ENTRYPOINT ["/work/afl_proxy"]
