# Parser-line AFL++ bridge generated by scripts/build_afl_bridge.py
FROM --platform=linux/arm64 parsarium/ascii_ply-java-scalismo:local
RUN apt-get update -qq && apt-get install -y --no-install-recommends afl++=4.09c-1ubuntu3 clang \
    && rm -rf /var/lib/apt/lists/*
COPY fuzzing/afl-bridge/afl_proxy.c /work/afl_proxy.c
COPY fuzzing/afl-bridge/JavaCase.java /work/JavaCase.java
COPY fuzzing/afl-bridge/java_trace.py /work/afl_java_trace.py
COPY fuzzing/afl-native/ascii_ply/java/scalismo/afl_trace /work/afl_trace
ENV PARSARIUM_SUBJECT_PREFIX=/work/parser-source/
ENV PARSARIUM_FUZZ_ENTRY=GenericHarness.fuzzerTestOneInput
ENV PARSARIUM_JAVA_CLASSPATH=/work/classes:/work/lib/scalismo_3-1.0-RC1.jar:/work/lib/scala3-library_3-3.3.0.jar:/work/lib/scala-library-2.13.10.jar:/work/lib/scalactic_3-3.2.16.jar:/work/lib/breeze_3-2.1.0.jar:/work/lib/breeze-macros_3-2.1.0.jar:/work/lib/blas-3.0.1.jar:/work/lib/lapack-3.0.1.jar:/work/lib/arpack-3.0.1.jar:/work/lib/arpack_combined_all-0.1.jar:/work/lib/opencsv-2.3.jar:/work/lib/JTransforms-3.1.jar:/work/lib/JLargeArrays-1.5.jar:/work/lib/commons-math3-3.2.jar:/work/lib/slf4j-api-1.7.5.jar:/work/lib/scala-collection-compat_3-2.7.0.jar:/work/lib/spire_3-0.18.0.jar:/work/lib/spire-macros_3-0.18.0.jar:/work/lib/spire-platform_3-0.18.0.jar:/work/lib/spire-util_3-0.18.0.jar:/work/lib/algebra_3-2.8.0.jar:/work/lib/cats-kernel_3-2.8.0.jar:/work/lib/breeze-natives_3-2.1.0.jar:/work/lib/scalismo-niftijiojar-0.1.0.jar:/work/lib/scalismo-hdf5-json_3-0.1-RC1.jar:/work/lib/upickle_3-2.0.0.jar:/work/lib/ujson_3-2.0.0.jar:/work/lib/upickle-core_3-2.0.0.jar:/work/lib/geny_3-0.7.1.jar:/work/lib/upack_3-2.0.0.jar:/work/lib/upickle-implicits_3-2.0.0.jar:/work/lib/jhdf-0.6.10.jar:/work/lib/commons-lang3-3.12.0.jar:/work/lib/compress-lzf-1.1.2.jar:/work/lib/lz4-java-1.8.0.jar:/work/lib/scala-parallel-collections_3-1.0.4.jar:/work/lib/slf4j-nop-2.0.7.jar
ENV PARSARIUM_TARGET_CLASS=GenericHarness
ENV PARSARIUM_PARSER_JAR=/work/lib/scalismo_3-1.0-RC1.jar
ENV PARSARIUM_PARSER_SOURCES=/work/parser-source
ENV PARSARIUM_JACOCO_INCLUDES=*
RUN mkdir /work/afl-java-classes && javac -d /work/afl-java-classes /work/JavaCase.java
RUN AFL_LLVM_INSTRUMENT=CLASSIC afl-clang-fast -O2 /work/afl_proxy.c -ldl -o /work/afl_proxy
ENTRYPOINT ["/work/afl_proxy"]
