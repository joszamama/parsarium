# AFL++ overlay generated by scripts/build_afl_native.py
FROM ubuntu@sha256:065aa8626841f16057b78b027b464cd59c4fac36c204c72dcbf48d66f5fa8a96 AS build
RUN apt-get update -qq && apt-get install -y --no-install-recommends afl++=4.33c-1.1ubuntu1 python3 ca-certificates clang cmake curl libclang-rt-21-dev llvm ninja-build python3 \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /work
# The pinned tarball bundles libpng 1.6.57 and zlib 1.3.2 under 3rdparty/.
RUN curl --fail --location --retry 3 'https://github.com/opencv/opencv/archive/refs/tags/5.1.0.tar.gz' -o /work/source.tar.gz \
 && echo '638c1dae7e37e45afea21aa217dc667ad7cf57acc66cdf652c074f1e0e5ad6d2  /work/source.tar.gz' | sha256sum --check \
 && mkdir /work/source && tar -xzf /work/source.tar.gz -C /work/source --strip-components=1 \
 && echo '30cfe167a72b3739a198df5e4a2d4bfab4ceca52f2b18f89a1cca033f70b39ae  /work/source/modules/imgcodecs/src/grfmt_png.cpp' | sha256sum --check \
 && echo 'c1a2804226f10b6019e782f04543a514ac8888ee9ca39db93ba9cbe0649bc46a  /work/source/3rdparty/libpng/png.h' | sha256sum --check \
 && grep -q '#define PNG_LIBPNG_VER_STRING "1.6.57"' /work/source/3rdparty/libpng/png.h
COPY harness.cpp harness.h replay.cpp build.sh /work/
RUN python3 -c 'from pathlib import Path; p=Path("/work/build.sh"); s=p.read_text(); s=s.replace("clang++","AFL_CXX").replace("clang","afl-clang-fast").replace("AFL_CXX","afl-clang-fast++").replace(",undefined",",undefined -fno-sanitize=function"); p.write_text(s)' && chmod +x /work/build.sh && /work/build.sh \
 && { clang++ --version | head -1; llvm-cov --version | head -1; } > /work/toolchain.txt
FROM ubuntu@sha256:065aa8626841f16057b78b027b464cd59c4fac36c204c72dcbf48d66f5fa8a96
RUN apt-get update -qq && apt-get install -y --no-install-recommends afl++=4.33c-1.1ubuntu1 python3 libstdc++6 llvm python3 \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /work
COPY --from=build /work/replay /work/fuzzer /work/
COPY --from=build /work/source /work/source
COPY --from=build /work/toolchain.txt /work/toolchain.txt
COPY run-control.sh /work/run-control.sh
RUN chmod +x /work/run-control.sh
ENTRYPOINT ["/work/run-control.sh"]
